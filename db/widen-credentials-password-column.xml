<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="widen-credentials-password-column" author="curity">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="credentials" columnName="password"/>
        </preConditions>

        <modifyDataType tableName="credentials" columnName="password" newDataType="VARCHAR(4096)"/>

        <!-- Some databases (e.g. MySQL) drop the NOT NULL constraint when the column type is modified. -->
        <addNotNullConstraint tableName="credentials" columnName="password" columnDataType="VARCHAR(4096)"/>

        <rollback>
            <modifyDataType tableName="credentials" columnName="password" newDataType="VARCHAR(128)"/>
            <addNotNullConstraint tableName="credentials" columnName="password" columnDataType="VARCHAR(128)"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
